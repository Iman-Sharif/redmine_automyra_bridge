services:
  redmica:
    image: redmica/redmica:latest
    container_name: redmica-app
    restart: always
    ports:
      - "4000:3000"
    environment:
      - REDMINE_MAX_ATTACHMENT_SIZE=200
      - SECRET_KEY_BASE=16fea3ec8b936497567cf90016c5bb3fb09ce2057e4f5341b426cfc9e124af1b3706f34543a78f0fdb099d7929d0bc370eaba95d2197749b26a22ac85244cc24
    volumes:
      - ./files:/usr/src/redmine/files
      - ./plugins:/usr/src/redmine/plugins
      - ./themes:/usr/src/redmine/public/themes
      - ./config/database.yml:/usr/src/redmine/config/database.yml
    depends_on:
      - db
    command: >
      /bin/sh -c "
      bundle install &&
      rake redmine:plugins:migrate RAILS_ENV=production &&
      bundle exec rails server -b 0.0.0.0 -p 3000"
    networks:
      - redmica-internal
    labels:
      - "com.centurylinklabs.watchtower.enable=true"

  db:
    image: mysql:5.7
    container_name: redmica-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: yourpassword
      MYSQL_DATABASE: redmica
      MYSQL_USER: redmica
      MYSQL_PASSWORD: redmica
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - redmica-internal
    labels:
      - "com.centurylinklabs.watchtower.enable=true"

volumes:
  db_data:

networks:
  redmica-internal:
    driver: bridge

  vpn_network:
    external: true
