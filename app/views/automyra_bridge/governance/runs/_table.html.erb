<table class="list">
  <thead><tr><th>ID</th><th>Policy</th><th>Status</th><th>Reason</th><th>Findings</th><th>Actions</th><th>Applied</th><th>Provider</th><th>Created</th><th></th></tr></thead>
  <tbody>
    <% runs.each do |run| %>
      <tr class="<%= cycle('odd', 'even') %>">
        <td><%= link_to "##{run.id}", automyra_bridge_governance_run_path(run, { project_id: run.governance_policy.project_id }.compact) %></td>
        <td><%= link_to run.governance_policy.name, automyra_bridge_governance_policy_path(run.governance_policy) %></td>
        <td><span class="hub-badge hub-badge--<%= run.completed? ? 'success' : (run.failed? ? 'danger' : (run.cancelled? ? 'neutral' : (run.running? ? 'info' : 'warning'))) %>"><%= h run.status %></span></td>
        <td><%= run.error_message.present? ? h(truncate(run.error_message, length: 120)) : '—' %></td>
        <td><%= run.findings_count %></td><td><%= run.actions_count %></td><td><%= run.applied_count %></td>
        <td><%= h run.provider_model_used %></td>
        <td><%= format_time(run.created_at) %></td>
        <td>
          <button type="button" class="button-small automyra-copy-run-details" data-copy-text="<%= h(governance_run_copy_text(run)) %>" onclick="navigator.clipboard.writeText(this.dataset.copyText); this.textContent = 'Copied'; setTimeout(() => { this.textContent = 'Copy'; }, 1500);">Copy</button>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
